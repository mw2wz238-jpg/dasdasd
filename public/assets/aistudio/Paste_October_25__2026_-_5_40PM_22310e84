      {screen === 'PLAYING' && !locked && !buyOpen && !scoreOpen && !paused && !result && (
        <button
          onClick={() => apiRef.current?.requestLock?.()}
          className="absolute inset-0 z-20 flex items-center justify-center bg-background/40 backdrop-blur-[2px]"
        >
