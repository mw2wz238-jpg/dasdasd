import React, { useEffect, useRef } from 'react';
import * as THREE from 'three';
import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';
import { OutputPass } from 'three/examples/jsm/postprocessing/OutputPass.js';
import { World } from '@/game/world';
import { Match } from '@/game/match';
import { Player } from '@/game/player';
import { Effects } from '@/game/effects';
import { WEAPONS } from '@/game/weapons';
import { setAnisotropy } from '@/game/textures';

export default function GameCanvas({
  mapId,
  playing,
  active,
  sessionKey,
  onSnapshot,
  onMatchEnd,
  onPlayerDeath,
  onLockChange,
  onRoundEnd,
}) {
  const hostRef = useRef(null);
  const engineRef = useRef(null);
  const propsRef = useRef({ playing, active, onSnapshot, onMatchEnd, onPlayerDeath, onRoundEnd });
  propsRef.current = { playing, active, onSnapshot, onMatchEnd, onPlayerDeath, onRoundEnd };

  /* ------------------------------------------------------------------ */
  /* Engine bootstrap (once)                                             */
  /* ------------------------------------------------------------------ */
  useEffect(() => {
    const host = hostRef.current;
    if (!host) return;

    const isSoftwareGl = (() => {
      const gl = document.createElement('canvas').getContext('webgl2');
      if (!gl) return true;
      const ext = gl.getExtension('WEBGL_debug_renderer_info');
      const param = ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER;
      const gpu = String(gl.getParameter(param));
      gl.getExtension('WEBGL_lose_context')?.loseContext();
      return /SwiftShader|llvmpipe|softpipe|Software|Basic/.test(gpu);
    })();

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(78, window.innerWidth / window.innerHeight, 0.05, 900);
    scene.add(camera);

    const renderer = new THREE.WebGLRenderer({
      antialias: !isSoftwareGl,
      powerPreference: 'high-performance',
      stencil: false,
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(isSoftwareGl ? 1 : Math.min(window.devicePixelRatio, 1.75));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.0;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    host.appendChild(renderer.domElement);

    setAnisotropy(renderer.capabilities.getMaxAnisotropy());

    const composer = new EffectComposer(renderer);
    composer.addPass(new RenderPass(scene, camera));
    const bloom = new UnrealBloomPass(
      new THREE.Vector2(window.innerWidth, window.innerHeight),
      isSoftwareGl ? 0.25 : 0.42,
      0.62,
      0.86
    );
    composer.addPass(bloom);
    composer.addPass(new OutputPass());

    const effects = new Effects(scene);
    const world = new World(scene, renderer);

    const engine = {
      scene,
      camera,
      renderer,
      composer,
      bloom,
      effects,
      world,
      player: null,
      match: null,
      mapId: null,
      time: 0,
      running: false,
      hitmarker: null,
      damage: null,
      raf: 0,
    };
    engineRef.current = engine;

    /* ---------------- match wiring ---------------- */
    const createMatch = (map, data) => {
      if (engine.match) engine.match.dispose();
      engine.mapId = map;

      const match = new Match(scene, world, effects, {
        onPlayerSpawn: (pos) => {
          if (engine.player) engine.player.reset(pos);
        },
        onHitmarker: (headshot) => {
          engine.hitmarker = { ts: performance.now(), headshot };
        },
        onPlayerDamage: (amount, attackerPos) => {
          const toAttacker = attackerPos.clone().sub(camera.position);
          toAttacker.y = 0;
          toAttacker.normalize();
          const camDir = new THREE.Vector3();
          camera.getWorldDirection(camDir);
          camDir.y = 0;
          camDir.normalize();
          const angle = Math.atan2(
            toAttacker.x * camDir.z - toAttacker.z * camDir.x,
            toAttacker.x * camDir.x + toAttacker.z * camDir.z
          );
          engine.damage = { ts: performance.now(), angle, amount };
        },
        onPlayerDeath: (killer) => {
          if (engine.player) engine.player.mouseDown = false;
          propsRef.current.onPlayerDeath && propsRef.current.onPlayerDeath(killer);
        },
        onMatchEnd: (result) => {
          document.exitPointerLock?.();
          propsRef.current.onMatchEnd && propsRef.current.onMatchEnd(result);
        },
        onRoundEnd: (info) => {
          propsRef.current.onRoundEnd && propsRef.current.onRoundEnd(info);
        },
      });

      match.start(map, data);
      engine.match = match;

      const surface = map === 'winter_village' ? 'snow' : map === 'night_docks' ? 'wood' : 'concrete';
      if (!engine.player) {
        engine.player = new Player(camera, scene, match, effects, surface);
      } else {
        engine.player.match = match;
        engine.player.surface = surface;
        engine.player.weaponId = null;
      }
      engine.player.reset(data.allySpawns[2].clone());
      engine.player.cameraBaseFov = 78;
    };
    engine.createMatch = createMatch;

    /* ---------------- map boot ---------------- */
    const mapData = world.build(mapId);
    createMatch(mapId, mapData);
    engine.mapData = mapData;
    if (mapId === 'night_docks') bloom.strength = 0.55;
    if (mapId === 'winter_village') bloom.strength = 0.34;

    /* ---------------- input ---------------- */
    const onKeyDown = (e) => {
      if (!engine.player) return;
      if (['Tab', 'Space', 'KeyB'].includes(e.code)) e.preventDefault();
      engine.player.keys[e.code] = true;
    };
    const onKeyUp = (e) => {
      if (!engine.player) return;
      engine.player.keys[e.code] = false;
    };
    const onMouseDown = (e) => {
      if (!engine.player) return;
      if (e.button === 0) engine.player.mouseDown = true;
      if (e.button === 2) engine.player.setAds(true);
    };
    const onMouseUp = (e) => {
      if (!engine.player) return;
      if (e.button === 0) engine.player.mouseDown = false;
      if (e.button === 2) engine.player.setAds(false);
    };
    const onMouseMove = (e) => {
      if (!engine.player) return;
      if (document.pointerLockElement !== renderer.domElement) return;
      engine.player.onMouseMove(e.movementX || 0, e.movementY || 0);
    };
    const onContext = (e) => e.preventDefault();
    const onLockChange = () => {
      onLockChange && onLockChange(document.pointerLockElement === renderer.domElement);
    };

    window.addEventListener('keydown', onKeyDown);
    window.addEventListener('keyup', onKeyUp);
    window.addEventListener('mousedown', onMouseDown);
    window.addEventListener('mouseup', onMouseUp);
    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('contextmenu', onContext);
    document.addEventListener('pointerlockchange', onLockChange);

    const handleResize = () => {
      const w = window.innerWidth;
      const h = window.innerHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
      composer.setSize(w, h);
      bloom.setSize(w, h);
    };
    window.addEventListener('resize', handleResize);

    /* ---------------- loop ---------------- */
    let last = performance.now();
    let uiAccum = 0;

    const loop = (now) => {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      engine.time += dt;

      const p = engine.player;
      const m = engine.match;

      if (p && m) {
        if (propsRef.current.playing) {
          p.update(dt);
          m.update(dt, engine.time);
        } else {
          // cinematic orbit for menu / pause
          const orbit = engine.mapData.orbitRadius;
          const angle = engine.time * 0.07;
          camera.position.set(Math.cos(angle) * orbit, 21, Math.sin(angle) * orbit);
          camera.lookAt(engine.mapData.center);
        }

        uiAccum += dt;
        if (uiAccum > 0.1 && propsRef.current.playing) {
          uiAccum = 0;
          const snap = m.getSnapshot();
          const weapon = WEAPONS[m.player.weaponId] || WEAPONS.p250;
          snap.mag = m.player.mag;
          snap.reserve = m.player.reserve;
          snap.weaponName = weapon.name;
          snap.weaponCategory = weapon.category;
