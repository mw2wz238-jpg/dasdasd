    victim.hp = 0;
    victim.deaths += 1;
    killer.kills += 1;
    killer.cash = Math.min(16000, killer.cash + (weapon ? weapon.killReward : 300));

    const entry = {
      id: `k${this.killCounter++}`,
      killer: killer.name,
      killerTeam: killer.team,
      victim: victim.name,
      victimTeam: victim.team,
      weapon: weapon ? weapon.name : '—',
      headshot,
      time: performance.now(),
    };
    this.killfeed.unshift(entry);
    if (this.killfeed.length > 6) this.killfeed.pop();

    if (victim.mesh) victim.mesh.visible = false;
    if (victim.isPlayer && this.callbacks.onPlayerDeath) this.callbacks.onPlayerDeath(killer.name);
    if (this.callbacks.onKill) this.callbacks.onKill(entry);

    if (this.state === 'LIVE_COMBAT') this.checkRoundEnd();
  }

  aliveOf(team) {
    return this.combatants.filter((c) => c.team === team && c.alive).length;
  }

  checkRoundEnd() {
    const allies = this.aliveOf('VANGUARD');
    const enemies = this.aliveOf('SYNDICATE');
    if (enemies === 0 && allies > 0) this.endRound('VANGUARD', 'Eliminacja przeciwnika');
    else if (allies === 0 && enemies > 0) this.endRound('SYNDICATE', 'Drużyna wyeliminowana');
    else if (allies === 0 && enemies === 0) this.endRound('VANGUARD', 'Obie drużyny wyeliminowane');
  }

  endRound(winner, reason) {
    if (this.state === 'ROUND_END' || this.state === 'MATCH_END') return;
    this.setState('ROUND_END');
    this.roundTimer = ROUND_END_TIME;
    this.lastRoundResult = { winner, reason };

