        new THREE.Vector3(3, 0, 48),
        new THREE.Vector3(8, 0, 46),
        new THREE.Vector3(-8, 0, 48),
        new THREE.Vector3(13, 0, 48),
      ],
      enemySpawns: [
        new THREE.Vector3(-4, 0, -50),
        new THREE.Vector3(1, 0, -52),
        new THREE.Vector3(6, 0, -50),
        new THREE.Vector3(-10, 0, -52),
        new THREE.Vector3(11, 0, -52),
      ],
      sites: { A: siteA, B: siteB },
      bounds: { minX: -62, maxX: 62, minZ: -62, maxZ: 62 },
      center: new THREE.Vector3(0, 8, 0),
      orbitRadius: 70,
    };
  }

