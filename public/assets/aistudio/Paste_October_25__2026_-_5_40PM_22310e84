  }

  syncWeaponModel() {
    const p = this.match.player;
    if (!p) return;
    if (this.weaponId === p.weaponId && this.viewmodel) return;
    this.weaponId = p.weaponId;

    if (this.viewmodel) {
      this.camera.remove(this.viewmodel.group);
      this.viewmodel.group.traverse((n) => {
        if (n.geometry) n.geometry.dispose();
      });
    }
    const vm = createViewModel(p.weaponId);
    vm.group.position.set(0.24, -0.22, -0.45);
    vm.group.rotation.set(0, 0.04, 0);
    vm.group.renderOrder = 10;
    vm.group.traverse((n) => {
      n.castShadow = false;
      n.receiveShadow = false;
      if (n.material) n.material.depthTest = true;
    });
    this.camera.add(vm.group);
    this.viewmodel = vm;
  }

  onMouseMove(dx, dy) {
    const sensitivity = 0.0021 * (this.ads ? 0.55 : 1);
    this.yaw -= dx * sensitivity;
    this.pitch -= dy * sensitivity;
    const limit = Math.PI / 2 - 0.05;
    this.pitch = Math.max(-limit, Math.min(limit, this.pitch));
  }

  setAds(value) {
    this.ads = value;
  }

  startReload() {
    const p = this.match.player;
    if (!p || !p.alive || this.reloading) return;
    const w = WEAPONS[p.weaponId];
    if (!w || p.mag >= w.magSize || p.reserve <= 0) return;
    this.reloading = true;
    this.reloadTimer = w.reloadTimeSec;
    SFX.reloadStep(false);
    setTimeout(() => SFX.reloadStep(true), w.reloadTimeSec * 500);
  }

  tryFire() {
    const p = this.match.player;
    if (!p || !p.alive) return;
    if (this.match.state !== 'LIVE_COMBAT') return;
    if (!this.mouseDown || this.reloading) return;
    if (this.time < this.nextShot) return;

    const w = WEAPONS[p.weaponId];
    if (!w) return;

    if (p.mag <= 0) {
      if (!this.dryPlayed) {
        SFX.dryFire();
        this.dryPlayed = true;
      }
      return;
    }
    this.dryPlayed = false;

    this.nextShot = this.time + 60 / w.fireRateRPM;
    p.mag -= 1;

    const speedFactor = Math.min(1.8, Math.hypot(this.vel.x, this.vel.z) / WALK_SPEED);
    const baseSpread = this.ads ? w.spreadAds : w.spreadNormal;
    const spread = baseSpread * (1 + speedFactor * 0.9) * (this.isCrouching ? 0.75 : 1);

    const origin = new THREE.Vector3();
    this.camera.getWorldPosition(origin);
    const baseDir = new THREE.Vector3();
    this.camera.getWorldDirection(baseDir);
    const right = new THREE.Vector3().setFromMatrixColumn(this.camera.matrixWorld, 0);
    const up = new THREE.Vector3().setFromMatrixColumn(this.camera.matrixWorld, 1);

    const muzzle = new THREE.Vector3();
    if (this.viewmodel) {
      this.viewmodel.muzzle.getWorldPosition(muzzle);
    } else {
      muzzle.copy(origin);
    }

    for (let i = 0; i < w.pellets; i++) {
      const dir = baseDir
        .clone()
        .addScaledVector(right, (Math.random() - 0.5) * spread * 2)
        .addScaledVector(up, (Math.random() - 0.5) * spread * 2)
        .normalize();
      const result = this.match.resolveShot(origin, dir, w, p, true);
      if (result.hit) {
        this.effects.impact(result.point, result.target && result.target.armor > 0 ? 0xbfd8ff : 0xff9b6a, 2);
      } else if (result.point) {
        this.effects.impact(result.point, 0xffcf8a, 1);
      }
      this.effects.tracer(muzzle, result.point, 0xffe1a8);
    }

    this.effects.muzzle(muzzle, w.category === 'sniper' ? 0xfff0c0 : 0xffd29a, w.category === 'sniper' ? 1.6 : 1.1);
    SFX.shot(w.category);

    // recoil
    const adsFactor = this.ads ? 0.6 : 1;
    this.recoilPitch += w.recoilVertical * adsFactor * (0.85 + Math.random() * 0.3);
    this.recoilYaw += (Math.random() - 0.5) * w.recoilHorizontal * adsFactor * 2;
    this.kick = Math.min(0.09, this.kick + 0.05 * adsFactor);
    this.shakeT = 0.09;

    // camera shake on big calibres
    if (w.category === 'sniper' || w.category === 'shotgun') this.shakeT = 0.18;
  }

  update(dt) {
    this.time += dt;
    const p = this.match.player;
    if (!p) return;

    this.syncWeaponModel();

    if (!p.alive) {
      this.recoilPitch *= Math.pow(0.001, dt);
      this.pitch += (0 - this.pitch) * Math.min(1, dt * 1.6);
      this.applyCamera(dt, -0.85);
      return;
    }

    // --- input direction ---
    const forward = new THREE.Vector3(-Math.sin(this.yaw), 0, -Math.cos(this.yaw));
    const right = new THREE.Vector3(Math.cos(this.yaw), 0, -Math.sin(this.yaw));
    const wish = new THREE.Vector3();
    if (this.keys['KeyW']) wish.add(forward);
    if (this.keys['KeyS']) wish.sub(forward);
    if (this.keys['KeyD']) wish.add(right);
    if (this.keys['KeyA']) wish.sub(right);
    if (wish.lengthSq() > 0) wish.normalize();

    this.isCrouching = !!(this.keys['KeyC'] || this.keys['ControlLeft']);
    this.isSprinting = !!(this.keys['ShiftLeft'] || this.keys['ShiftRight']) && !this.isCrouching && !this.ads && wish.lengthSq() > 0;

    let speed = WALK_SPEED;
    if (this.isSprinting) speed = SPRINT_SPEED;
    else if (this.isCrouching) speed = CROUCH_SPEED;
    else if (this.ads) speed = ADS_SPEED;

    const targetVel = wish.multiplyScalar(speed);
    const accel = this.onGround ? 12 : 3.5;
    this.vel.x += (targetVel.x - this.vel.x) * Math.min(1, accel * dt);
    this.vel.z += (targetVel.z - this.vel.z) * Math.min(1, accel * dt);

    // gravity + jump
    if (this.keys['Space'] && this.onGround) {
      this.vel.y = JUMP_VELOCITY;
      this.onGround = false;
      SFX.footstep(this.surface);
    }
    this.vel.y -= GRAVITY * dt;

    this.pos.x += this.vel.x * dt;
    this.pos.z += this.vel.z * dt;
    this.pos.y += this.vel.y * dt;

    resolveCollisions(this.pos, 0.42, this.pos.y, this.match.colliders);

    const bounds = this.match.mapData.bounds;
    this.pos.x = Math.max(bounds.minX + 1.5, Math.min(bounds.maxX - 1.5, this.pos.x));
    this.pos.z = Math.max(bounds.minZ + 1.5, Math.min(bounds.maxZ - 1.5, this.pos.z));

    const groundY = supportHeight(this.pos.x, this.pos.z, 0.42, this.pos.y, this.match.colliders);
    if (this.pos.y <= groundY) {
      if (this.vel.y < -6) {
        this.landDip = Math.min(0.14, Math.abs(this.vel.y) * 0.012);
        SFX.footstep(this.surface);
      }
      this.pos.y = groundY;
      this.vel.y = 0;
      this.onGround = true;
    } else {
      this.onGround = false;
    }

    // footsteps
    const planarSpeed = Math.hypot(this.vel.x, this.vel.z);
    if (this.onGround && planarSpeed > 1.2) {
      this.footTimer -= dt * (this.isSprinting ? 1.6 : 1);
      if (this.footTimer <= 0) {
        this.footTimer = this.isCrouching ? 0.75 : 0.46;
        SFX.footstep(this.surface);
      }
      this.bobPhase += dt * (this.isSprinting ? 12 : 8) * (planarSpeed / WALK_SPEED);
    } else {
      this.bobPhase += dt * 1.2;
    }

    // reload
    if (this.reloading) {
      this.reloadTimer -= dt;
      if (this.reloadTimer <= 0) {
        const w = WEAPONS[p.weaponId];
        const need = w.magSize - p.mag;
        const take = Math.min(need, p.reserve);
        p.mag += take;
        p.reserve -= take;
        this.reloading = false;
      }
    }

    if (p.mag <= 0 && p.reserve > 0 && !this.reloading) this.startReload();

    // ADS transition
    const adsTarget = this.ads && !this.isSprinting && !this.reloading ? 1 : 0;
    this.adsLerp += (adsTarget - this.adsLerp) * Math.min(1, dt * 11);

    // recoil recovery
    this.recoilPitch *= Math.pow(0.0015, dt);
    this.recoilYaw *= Math.pow(0.0015, dt);
    this.kick *= Math.pow(0.0008, dt);
    this.shakeT = Math.max(0, this.shakeT - dt);
    this.landDip *= Math.pow(0.0006, dt);

    this.applyCamera(dt);

    // sync logical position for AI
    p.pos.copy(this.pos);
    p.yaw = this.yaw;

    this.tryFire();
  }

  applyCamera(dt, deathOffset = 0) {
    const eye = 1.62 - (this.isCrouching ? 0.42 : 0) - this.landDip;
    const bobAmount = this.ads ? 0.12 : 1;
    const bobY = Math.sin(this.bobPhase * 2) * 0.022 * bobAmount;
    const bobX = Math.cos(this.bobPhase) * 0.018 * bobAmount;

    this.camera.position.set(this.pos.x + bobX * 0.3, this.pos.y + eye + bobY + deathOffset, this.pos.z);

    const shake = this.shakeT > 0 ? this.shakeT * 0.035 : 0;
    this.camera.rotation.set(
      this.pitch + this.recoilPitch + (Math.random() - 0.5) * shake,
      this.yaw + this.recoilYaw + (Math.random() - 0.5) * shake,
      Math.sin(this.bobPhase) * 0.004 * bobAmount
    );

    const w = WEAPONS[this.match.player.weaponId] || WEAPONS.p250;
    const targetFov = this.cameraBaseFov + (w.adsFov - this.cameraBaseFov) * this.adsLerp;
    if (Math.abs(this.camera.fov - targetFov) > 0.05) {
      this.camera.fov += (targetFov - this.camera.fov) * Math.min(1, (dt || 0.016) * 12);
      this.camera.updateProjectionMatrix();
    }

    if (this.viewmodel) {
      const vm = this.viewmodel.group;
      const hip = { x: 0.24, y: -0.22, z: -0.45 };
      const aim = { x: 0, y: -0.145, z: -0.32 };
      const swayX = Math.cos(this.bobPhase) * 0.012 * bobAmount * (1 - this.adsLerp);
      const swayY = Math.sin(this.bobPhase * 2) * 0.01 * bobAmount * (1 - this.adsLerp);
      const reloadDip = this.reloading ? -0.09 : 0;

      vm.position.x += (hip.x + (aim.x - hip.x) * this.adsLerp + swayX - vm.position.x) * Math.min(1, 12 * (dt || 0.016));
      vm.position.y += (hip.y + (aim.y - hip.y) * this.adsLerp + swayY + reloadDip - vm.position.y) * Math.min(1, 12 * (dt || 0.016));
      vm.position.z += (hip.z + (aim.z - hip.z) * this.adsLerp + this.kick - vm.position.z) * Math.min(1, 14 * (dt || 0.016));
      vm.rotation.x += ((this.reloading ? -0.35 : 0) + this.kick * 2 - vm.rotation.x) * Math.min(1, 10 * (dt || 0.016));
      vm.rotation.z += ((this.adsLerp * 0.0) - vm.rotation.z) * Math.min(1, 10 * (dt || 0.016));
    }
  }
