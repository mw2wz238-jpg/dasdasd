/**
 * Shared collision / ray utilities. Colliders are axis aligned boxes:
 * { minX, minY, minZ, maxX, maxY, maxZ, kind }
 */

export const STEP_HEIGHT = 0.45;

export function makeBox(x, y, z, w, h, d, kind = 'concrete') {
  return {
    minX: x - w / 2,
    minY: y,
    minZ: z - d / 2,
    maxX: x + w / 2,
    maxY: y + h,
    maxZ: z + d / 2,
    kind,
  };
}

export function supportHeight(x, z, radius, feetY, colliders) {
  let height = 0;
  for (let i = 0; i < colliders.length; i++) {
    const b = colliders[i];
    if (b.minX - radius * 0.5 > x || b.maxX + radius * 0.5 < x) continue;
    if (b.minZ - radius * 0.5 > z || b.maxZ + radius * 0.5 < z) continue;
    if (b.maxY <= feetY + STEP_HEIGHT && b.maxY > height) height = b.maxY;
  }
  return height;
}

/**
 * Push a capsule (circle in XZ) out of every box it overlaps horizontally.
 * Boxes whose top is within step height of the feet are walkable and ignored.
 */
export function resolveCollisions(pos, radius, feetY, colliders) {
  for (let i = 0; i < colliders.length; i++) {
    const b = colliders[i];
    if (b.maxY <= feetY + STEP_HEIGHT) continue;
    if (b.minY > feetY + 1.75) continue;
    if (b.maxX < pos.x - radius || b.minX > pos.x + radius) continue;
    if (b.maxZ < pos.z - radius || b.minZ > pos.z + radius) continue;

    const closestX = Math.max(b.minX, Math.min(pos.x, b.maxX));
    const closestZ = Math.max(b.minZ, Math.min(pos.z, b.maxZ));
    let dx = pos.x - closestX;
    let dz = pos.z - closestZ;
    const dist = Math.hypot(dx, dz);

    if (dist > 0.0001) {
      if (dist < radius) {
        const push = (radius - dist) / dist;
        pos.x += dx * push;
        pos.z += dz * push;
      }
    } else {
      const left = pos.x - b.minX;
      const right = b.maxX - pos.x;
      const back = pos.z - b.minZ;
      const front = b.maxZ - pos.z;
      const min = Math.min(left, right, back, front);
      if (min === left) pos.x = b.minX - radius;
      else if (min === right) pos.x = b.maxX + radius;
      else if (min === back) pos.z = b.minZ - radius;
      else pos.z = b.maxZ + radius;
    }
  }
}

export function rayBox(ox, oy, oz, dx, dy, dz, maxT, b) {
  let tmin = 0;
  let tmax = maxT;

  if (Math.abs(dx) < 1e-8) {
    if (ox < b.minX || ox > b.maxX) return -1;
  } else {
    const inv = 1 / dx;
    let t1 = (b.minX - ox) * inv;
    let t2 = (b.maxX - ox) * inv;
    if (t1 > t2) [t1, t2] = [t2, t1];
    tmin = Math.max(tmin, t1);
    tmax = Math.min(tmax, t2);
    if (tmin > tmax) return -1;
  }

  if (Math.abs(dy) < 1e-8) {
    if (oy < b.minY || oy > b.maxY) return -1;
  } else {
    const inv = 1 / dy;
    let t1 = (b.minY - oy) * inv;
    let t2 = (b.maxY - oy) * inv;
    if (t1 > t2) [t1, t2] = [t2, t1];
    tmin = Math.max(tmin, t1);
    tmax = Math.min(tmax, t2);
    if (tmin > tmax) return -1;
  }

  if (Math.abs(dz) < 1e-8) {
    if (oz < b.minZ || oz > b.maxZ) return -1;
  } else {
    const inv = 1 / dz;
    let t1 = (b.minZ - oz) * inv;
    let t2 = (b.maxZ - oz) * inv;
    if (t1 > t2) [t1, t2] = [t2, t1];
    tmin = Math.max(tmin, t1);
    tmax = Math.min(tmax, t2);
    if (tmin > tmax) return -1;
  }

  return tmin;
}

export function rayWorld(origin, dir, maxT, colliders) {
  let best = maxT;
  let hit = null;
  for (let i = 0; i < colliders.length; i++) {
    const b = colliders[i];
    const t = rayBox(origin.x, origin.y, origin.z, dir.x, dir.y, dir.z, best, b);
    if (t >= 0 && t < best) {
      best = t;
      hit = b;
    }
  }
  return { t: best, box: hit };
}

export function hasLineOfSight(from, to, colliders) {
  const dx = to.x - from.x;
  const dy = to.y - from.y;
  const dz = to.z - from.z;
  const dist = Math.hypot(dx, dy, dz);
  if (dist < 0.001) return true;
  const dir = { x: dx / dist, y: dy / dist, z: dz / dist };
  const hit = rayWorld(from, dir, dist - 0.25, colliders);
  return !hit.box;
}

export function raySphere(ox, oy, oz, dx, dy, dz, cx, cy, cz, radius) {
  const lx = cx - ox;
  const ly = cy - oy;
  const lz = cz - oz;
  const tca = lx * dx + ly * dy + lz * dz;
  if (tca < 0) return -1;
  const d2 = lx * lx + ly * ly + lz * lz - tca * tca;
  const r2 = radius * radius;
  if (d2 > r2) return -1;
  const thc = Math.sqrt(r2 - d2);
  return tca - thc;
}


