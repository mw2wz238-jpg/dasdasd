import * as THREE from 'three';

/**
 * Procedural PBR texture library.
 * Each surface is generated at runtime as albedo + roughness + normal maps so the
 * whole game ships without external texture assets while still using physically
 * based shading (roughness/metalness workflow, tiling, anisotropy, mipmaps).
 */

let ANISO = 4;
export function setAnisotropy(value) {
  ANISO = Math.max(1, Math.min(8, value || 4));
}

const fract = (v) => v - Math.floor(v);
const clamp01 = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);
const mix = (a, b, t) => a + (b - a) * t;
const smoothstep = (a, b, x) => {
  const t = clamp01((x - a) / (b - a || 1e-6));
  return t * t * (3 - 2 * t);
};

function hash(x, y, seed) {
  const s = Math.sin(x * 127.1 + y * 311.7 + seed * 74.7) * 43758.5453123;
  return s - Math.floor(s);
}

function noiseT(x, y, period, seed) {
  const xi = Math.floor(x);
  const yi = Math.floor(y);
  const xf = x - xi;
  const yf = y - yi;
  const u = xf * xf * (3 - 2 * xf);
  const v = yf * yf * (3 - 2 * yf);
  const p = Math.max(1, Math.round(period));
  const wrap = (a, b) => hash(((a % p) + p) % p, ((b % p) + p) % p, seed);
  const a00 = wrap(xi, yi);
  const a10 = wrap(xi + 1, yi);
  const a01 = wrap(xi, yi + 1);
  const a11 = wrap(xi + 1, yi + 1);
  const top = a00 * (1 - u) + a10 * u;
  const bot = a01 * (1 - u) + a11 * u;
  return top * (1 - v) + bot * v;
}

function fbm(u, v, freq, octaves, seed) {
  let sum = 0;
  let amp = 0.5;
  let f = freq;
  let norm = 0;
  for (let i = 0; i < octaves; i++) {
    sum += amp * noiseT(u * f, v * f, f, seed + i * 17);
    norm += amp;
    amp *= 0.5;
    f *= 2;
  }
  return sum / norm;
}

const SURFACES = {
  asphalt: {
    metalness: 0.08,
    normalStrength: 2.4,
    sample: (u, v) => {
      const base = fbm(u, v, 3, 5, 7);
      const grit = fbm(u, v, 48, 2, 41);
      const wet = smoothstep(0.52, 0.78, fbm(u, v, 2, 4, 91));
      const crack = Math.abs(fbm(u, v, 7, 4, 53) - 0.5);
      const isCrack = crack < 0.012 ? 1 : 0;
      let g = 0.13 + base * 0.11 + grit * 0.07;
      g = mix(g, g * 0.45, wet);
      g *= 1 - isCrack * 0.55;
      const rough = mix(0.72 + grit * 0.22, 0.14, wet) + isCrack * 0.1;
      return {
        r: g * 1.02,
        g: g * 1.0,
        b: g * 0.98,
        rough: clamp01(rough),
        h: base * 0.7 + grit * 0.3 - isCrack * 0.6 - wet * 0.15,
      };
    },
  },
  concrete: {
    metalness: 0.04,
    normalStrength: 1.9,
    sample: (u, v) => {
      const n = fbm(u, v, 4, 5, 11);
      const fine = fbm(u, v, 30, 3, 31);
      const stain = smoothstep(0.55, 0.85, fbm(u, v, 2, 4, 77));
      const seam = fract(u * 2) < 0.012 || fract(v * 2) < 0.012 ? 1 : 0;
      let g = 0.5 + n * 0.16 + fine * 0.05;
      g = mix(g, g * 0.62, stain * 0.7);
      g *= 1 - seam * 0.45;
      return {
        r: g * 1.01,
        g: g,
        b: g * 0.96,
        rough: clamp01(0.78 + fine * 0.18 + seam * 0.12),
        h: n * 0.6 + fine * 0.2 - seam * 0.8,
      };
    },
  },
  container: {
    metalness: 0.62,
    normalStrength: 2.8,
    sample: (u, v) => {
      const corr = Math.sin(u * Math.PI * 2 * 16);
      const n = fbm(u, v, 5, 4, 123);
      const rust = smoothstep(0.52, 0.74, fbm(u, v, 3, 5, 223));
      const streak = smoothstep(0.6, 0.95, fbm(u * 3, v * 0.6, 4, 3, 331));
      let g = 0.62 + corr * 0.09 + n * 0.1;
      g = mix(g, 0.3 + n * 0.12, rust * 0.85);
      const r = mix(g, 0.42 + n * 0.2, rust * 0.9);
      const gg = mix(g, 0.24 + n * 0.12, rust * 0.9);
      const b = mix(g, 0.14 + n * 0.1, rust * 0.9);
      return {
        r,
        g: gg,
        b,
        rough: clamp01(0.42 + rust * 0.45 + streak * 0.1),
        h: 0.5 + corr * 0.4 + n * 0.2 - rust * 0.1,
      };
    },
  },
  metal: {
    metalness: 0.88,
    normalStrength: 1.4,
    sample: (u, v) => {
      const brush = fbm(u * 26, v * 2, 8, 3, 61);
      const n = fbm(u, v, 4, 4, 13);
      const dirt = smoothstep(0.6, 0.9, fbm(u, v, 3, 4, 141));
      const g = mix(0.46 + brush * 0.16 + n * 0.05, 0.24, dirt * 0.6);
      return {
        r: g,
        g: g * 1.01,
        b: g * 1.03,
        rough: clamp01(0.3 + brush * 0.22 + dirt * 0.3),
        h: brush * 0.7 + n * 0.3,
      };
    },
  },
  brick: {
    metalness: 0.02,
    normalStrength: 2.6,
    sample: (u, v) => {
      const rows = 10;
      const cols = 5;
      const row = Math.floor(v * rows);
      const offset = (row % 2) * 0.5;
      const bx = fract(u * cols + offset);
      const by = fract(v * rows);
      const mortar = bx < 0.035 || by < 0.09;
      const brickVar = hash(Math.floor(u * cols + offset), row, 9);
      const n = fbm(u, v, 16, 3, 5);
      let r = mix(0.36, 0.56, brickVar) + n * 0.05;
      let g = mix(0.19, 0.3, brickVar) + n * 0.04;
      let b = mix(0.16, 0.24, brickVar) + n * 0.04;
      if (mortar) {
        r = 0.55;
        g = 0.54;
        b = 0.51;
      }
      return {
        r,
        g,
        b,
        rough: clamp01(mortar ? 0.92 : 0.72 + n * 0.16),
        h: mortar ? 0.15 : 0.75 + brickVar * 0.2,
      };
    },
  },
  wood: {
    metalness: 0.03,
    normalStrength: 2.0,
    sample: (u, v) => {
      const planks = 6;
      const row = Math.floor(v * planks);
      const seam = fract(v * planks) < 0.05 ? 1 : 0;
      const grain = fbm(u * 2, v * 22, 9, 4, 71 + row);
      const n = fbm(u, v, 5, 3, 37);
      const tint = hash(row, 3, 19);
      let r = mix(0.32, 0.47, tint) + grain * 0.1;
      let g = mix(0.22, 0.33, tint) + grain * 0.08;
      let b = mix(0.14, 0.2, tint) + grain * 0.05;
      if (seam) {
        r *= 0.45;
        g *= 0.45;
        b *= 0.45;
      }
      return { r, g, b, rough: clamp01(0.72 + grain * 0.2), h: grain * 0.7 + (seam ? -0.6 : 0.3) + n * 0.2 };
    },
  },
  snow: {
    metalness: 0.02,
    normalStrength: 1.2,
    sample: (u, v) => {
      const n = fbm(u, v, 6, 5, 99);
      const drift = fbm(u, v, 2, 3, 199);
      const sparkle = hash(Math.floor(u * 256), Math.floor(v * 256), 3) > 0.995 ? 1 : 0;
      const g = 0.87 + n * 0.08 + drift * 0.04 + sparkle * 0.12;
      return {
        r: g * 0.97,
        g: g * 0.99,
        b: clamp01(g * 1.03),
        rough: clamp01(0.62 + n * 0.2 - sparkle * 0.3),
        h: drift * 0.7 + n * 0.3,
      };
    },
  },
  rock: {
    metalness: 0.03,
    normalStrength: 2.6,
    sample: (u, v) => {
      const n = fbm(u, v, 5, 5, 47);
      const crack = Math.abs(fbm(u, v, 9, 4, 87) - 0.5) < 0.02 ? 1 : 0;
      const g = 0.34 + n * 0.2 - crack * 0.15;
      return {
        r: g * 1.02,
        g: g * 0.98,
        b: g * 0.92,
        rough: clamp01(0.82 + n * 0.14),
        h: n - crack * 0.5,
      };
    },
  },
  roof: {
    metalness: 0.16,
    normalStrength: 2.2,
    sample: (u, v) => {
      const rows = 12;
      const row = Math.floor(v * rows);
      const tile = fract(u * 10 + (row % 2) * 0.5);
      const seam = tile < 0.06 || fract(v * rows) < 0.12 ? 1 : 0;
      const n = fbm(u, v, 8, 3, 57);
      const g = 0.16 + n * 0.09 - seam * 0.06;
      return {
        r: g * 1.05,
        g: g * 0.98,
        b: g * 0.94,
        rough: clamp01(0.55 + n * 0.3),
        h: 0.8 - seam * 0.7 + n * 0.2,
      };
    },
  },
};

const baseCache = new Map();
const matCache = new Map();
const glowCache = new Map();

function normalFromHeight(height, size, strength) {
  const data = new Uint8Array(size * size * 4);
  const idx = (x, y) => ((y + size) % size) * size + ((x + size) % size);
  for (let y = 0; y < size; y++) {
    for (let x = 0; x < size; x++) {
      const hL = height[idx(x - 1, y)];
      const hR = height[idx(x + 1, y)];
      const hD = height[idx(x, y - 1)];
      const hU = height[idx(x, y + 1)];
      let nx = (hL - hR) * strength;
      let ny = (hD - hU) * strength;
      let nz = 1;
      const len = Math.hypot(nx, ny, nz) || 1;
      nx /= len;
      ny /= len;
      nz /= len;
      const i = (y * size + x) * 4;
      data[i] = Math.round((nx * 0.5 + 0.5) * 255);
      data[i + 1] = Math.round((ny * 0.5 + 0.5) * 255);
      data[i + 2] = Math.round((nz * 0.5 + 0.5) * 255);
      data[i + 3] = 255;
    }
  }
  const tex = new THREE.DataTexture(data, size, size, THREE.RGBAFormat);
  tex.wrapS = THREE.RepeatWrapping;
  tex.wrapT = THREE.RepeatWrapping;
  tex.magFilter = THREE.LinearFilter;
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  tex.generateMipmaps = true;
  tex.anisotropy = ANISO;
  tex.needsUpdate = true;
  return tex;
}

function dataTexture(data, size, srgb) {
  const tex = new THREE.DataTexture(data, size, size, THREE.RGBAFormat);
  tex.wrapS = THREE.RepeatWrapping;
  tex.wrapT = THREE.RepeatWrapping;
  tex.magFilter = THREE.LinearFilter;
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  tex.generateMipmaps = true;
  tex.anisotropy = ANISO;
  if (srgb) tex.colorSpace = THREE.SRGBColorSpace;
  tex.needsUpdate = true;
  return tex;
}

function baseTextures(kind) {
  if (baseCache.has(kind)) return baseCache.get(kind);
  const def = SURFACES[kind] || SURFACES.concrete;
  const size = 256;
  const albedo = new Uint8Array(size * size * 4);
  const rough = new Uint8Array(size * size * 4);
  const height = new Float32Array(size * size);

  for (let y = 0; y < size; y++) {
    for (let x = 0; x < size; x++) {
      const s = def.sample(x / size, y / size);
      const i = (y * size + x) * 4;
      albedo[i] = Math.round(clamp01(s.r) * 255);
      albedo[i + 1] = Math.round(clamp01(s.g) * 255);
      albedo[i + 2] = Math.round(clamp01(s.b) * 255);
      albedo[i + 3] = 255;
      const rv = Math.round(clamp01(s.rough) * 255);
      rough[i] = rv;
      rough[i + 1] = rv;
      rough[i + 2] = rv;
      rough[i + 3] = 255;
      height[y * size + x] = s.h;
    }
  }

  const set = {
    albedo: dataTexture(albedo, size, true),
    roughness: dataTexture(rough, size, false),
    normal: normalFromHeight(height, size, def.normalStrength || 2),
    metalness: def.metalness ?? 0,
  };
  baseCache.set(kind, set);
  return set;
}

export function getMaterial(kind, opts = {}) {
  const {
    rx = 1,
    ry = 1,
    color = 0xffffff,
    metalness,
    roughness = 1,
    envMapIntensity = 1,
    normalScale = 1,
  } = opts;
  const key = `${kind}|${rx}|${ry}|${color}|${metalness}|${roughness}|${envMapIntensity}|${normalScale}`;
  const cached = matCache.get(key);
  if (cached) return cached;

  const set = baseTextures(kind);
  const clone = (tex, srgb) => {
    const c = tex.clone();
    c.wrapS = THREE.RepeatWrapping;
    c.wrapT = THREE.RepeatWrapping;
    c.repeat.set(rx, ry);
    c.anisotropy = ANISO;
    if (srgb) c.colorSpace = THREE.SRGBColorSpace;
    c.needsUpdate = true;
    return c;
  };

  const mat = new THREE.MeshStandardMaterial({
    map: clone(set.albedo, true),
    roughnessMap: clone(set.roughness, false),
    normalMap: clone(set.normal, false),
    normalScale: new THREE.Vector2(normalScale, normalScale),
    color: new THREE.Color(color),
    metalness: metalness ?? set.metalness,
    roughness,
    envMapIntensity,
  });
  matCache.set(key, mat);
  return mat;
}

export function getGlowMaterial(color, intensity = 2.5) {
  const key = `${color}|${intensity}`;
  if (glowCache.has(key)) return glowCache.get(key);
  const mat = new THREE.MeshStandardMaterial({
    color: new THREE.Color(color),
    emissive: new THREE.Color(color),
    emissiveIntensity: intensity,
    roughness: 0.6,
    metalness: 0,
  });
  glowCache.set(key, mat);
  return mat;
}

export function getSurfaceMaterial(kind) {
  return getMaterial(kind);
}

export function disposeMaterialCache() {
  baseCache.forEach((set) => {
    set.albedo.dispose();
    set.roughness.dispose();
    set.normal.dispose();
  });
  baseCache.clear();
  matCache.forEach((m) => {
    if (m.map) m.map.dispose();
    if (m.roughnessMap) m.roughnessMap.dispose();
    if (m.normalMap) m.normalMap.dispose();
    m.dispose();
  });
  matCache.clear();
}


