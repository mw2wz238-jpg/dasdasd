    this.root.add(top);
    const mid = top.clone();
    mid.position.y = 0.6;
    this.root.add(mid);
    const count = Math.max(2, Math.round(length / 1.6));
    for (let i = 0; i <= count; i++) {
      const t = (i / count - 0.5) * length;
      const post = new THREE.Mesh(new THREE.BoxGeometry(0.06, 1.1, 0.06), mat);
      post.position.set(x + Math.cos(rotY) * t, 0.55, z - Math.sin(rotY) * t);
      this.root.add(post);
    }
  }

  addSiteMarker(site) {
    const ringMat = new THREE.MeshBasicMaterial({
      color: 0xff9f45,
      transparent: true,
      opacity: 0.55,
      side: THREE.DoubleSide,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
    });
    const ring = new THREE.Mesh(new THREE.RingGeometry(site.radius - 0.35, site.radius, 48), ringMat);
    ring.rotation.x = -Math.PI / 2;
    ring.position.set(site.x, 0.03, site.z);
    this.root.add(ring);
    const fillMat = new THREE.MeshBasicMaterial({
      color: 0xff9f45,
      transparent: true,
      opacity: 0.06,
      depthWrite: false,
    });
    const fill = new THREE.Mesh(new THREE.CircleGeometry(site.radius, 40), fillMat);
    fill.rotation.x = -Math.PI / 2;
    fill.position.set(site.x, 0.02, site.z);
    this.root.add(fill);
    this.animated.push({ mesh: ring, type: 'pulse', base: 0.55 });
  }

  addBuilding(x, z, w, h, d, rotY, opts) {
    const { wallColor = 0x8d8273, roofColor = 0x35393e, windows = true, wallKind = 'concrete' } = opts || {};
    this.addBox(w, h, d, x, 0, z, wallKind, { rotY, color: wallColor, rx: Math.max(1, Math.round(w / 6)), ry: Math.max(1, Math.round(h / 3)) });
    this.addBox(w + 0.6, 0.4, d + 0.6, x, h, z, 'metal', { rotY, color: roofColor, collide: false });
    if (windows) {
      const glow = getGlowMaterial(0xffc078, 1.9);
      const cols = Math.max(2, Math.floor(w / 5));
      for (let i = 0; i < cols; i++) {
        const ox = (i / (cols - 1 || 1) - 0.5) * (w - 3);
        const win = new THREE.Mesh(new THREE.BoxGeometry(1.6, 1.1, 0.12), glow);
        win.position.set(x + Math.cos(rotY) * ox, h * 0.62, z - Math.sin(rotY) * ox - (d / 2 + 0.02) * Math.cos(rotY));
        win.rotation.y = rotY;
        this.root.add(win);
      }
    }
  }

  addTree(x, z, scale = 1, snowy = false) {
    const trunkMat = getMaterial('wood', { color: 0x4a3627, rx: 1, ry: 2 });
    this.addCylinder(0.16 * scale, 0.22 * scale, 2.4 * scale, x, 0, z, trunkMat, { collide: true, radius: 0.22 * scale });
    const needleMat = new THREE.MeshStandardMaterial({
      color: snowy ? 0x1f3b30 : 0x24422f,
      roughness: 0.92,
      metalness: 0.02,
    });
    const snowMat = new THREE.MeshStandardMaterial({ color: 0xe9f1fb, roughness: 0.65, metalness: 0.02 });
    for (let i = 0; i < 3; i++) {
      const r = (1.55 - i * 0.38) * scale;
      const cone = new THREE.Mesh(new THREE.ConeGeometry(r, 1.9 * scale, 12), needleMat);
      cone.position.set(x, (2.1 + i * 1.05) * scale, z);
      cone.castShadow = true;
      this.root.add(cone);
      if (snowy) {
        const cap = new THREE.Mesh(new THREE.ConeGeometry(r * 0.72, 0.55 * scale, 12), snowMat);
        cap.position.set(x, (2.55 + i * 1.05) * scale, z);
        this.root.add(cap);
      }
    }
  }

