            Kliknij, aby przejąć kontrolę
          </span>
        </button>
      )}

      {buyOpen && (
        <BuyMenu snap={snap} onBuy={handleBuy} onClose={() => setBuyOpen(false)} />
      )}

      {scoreOpen && <Scoreboard snap={snap} />}

      {paused && !result && (
        <PauseOverlay
          onResume={() => setPaused(false)}
          onMenu={toMenu}
          muted={muted}
          onToggleMute={toggleMute}
        />
      )}

      {result && <GameOverModal result={result} onRematch={rematch} onMenu={toMenu} />}
    </div>
  );
