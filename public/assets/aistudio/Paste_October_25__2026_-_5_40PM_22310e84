import * as THREE from 'three';

function radialTexture(inner = 'rgba(255,255,255,1)', outer = 'rgba(255,255,255,0)') {
  const size = 64;
  const canvas = document.createElement('canvas');
  canvas.width = size;
  canvas.height = size;
  const ctx = canvas.getContext('2d');
  const grad = ctx.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
  grad.addColorStop(0, inner);
  grad.addColorStop(0.35, 'rgba(255,255,255,0.55)');
  grad.addColorStop(1, outer);
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, size, size);
  const tex = new THREE.CanvasTexture(canvas);
  tex.colorSpace = THREE.SRGBColorSpace;
  return tex;
}

function streakTexture() {
  const canvas = document.createElement('canvas');
  canvas.width = 8;
  canvas.height = 64;
  const ctx = canvas.getContext('2d');
  const grad = ctx.createLinearGradient(0, 0, 0, 64);
  grad.addColorStop(0, 'rgba(255,255,255,0)');
  grad.addColorStop(0.5, 'rgba(255,255,255,0.95)');
  grad.addColorStop(1, 'rgba(255,255,255,0)');
  ctx.fillStyle = grad;
  ctx.fillRect(2, 0, 4, 64);
  const tex = new THREE.CanvasTexture(canvas);
  tex.colorSpace = THREE.SRGBColorSpace;
  return tex;
}

/**
 * Pooled, additive VFX: muzzle flashes, tracers, impacts, blood, smoke and wet-ground sparks.
 */
export class Effects {
  constructor(scene) {
    this.scene = scene;
    this.sprite = radialTexture();
    this.streak = streakTexture();
    this.items = [];
    this.tracers = [];
    this.pool = [];
    this.lights = [];
  }

  acquire(material, kind) {
    let obj = this.pool.find((p) => p.kind === kind && !p.active);
    if (!obj) {
      const mesh = new THREE.Sprite(material.clone());
      mesh.frustumCulled = false;
      this.scene.add(mesh);
      obj = { mesh, kind, active: false, life: 0, maxLife: 1, vel: new THREE.Vector3(), spin: 0 };
      this.pool.push(obj);
    }
    obj.active = true;
    obj.mesh.visible = true;
    return obj;
  }

  flashMaterial(color) {
    const mat = new THREE.SpriteMaterial({
      map: this.sprite,
      color: new THREE.Color(color),
      blending: THREE.AdditiveBlending,
      transparent: true,
      depthWrite: false,
    });
    return mat;
  }

  muzzle(position, color = 0xffd9a0, scale = 1) {
    const obj = this.acquire(this.flashMaterial(color), 'flash');
    obj.mesh.position.copy(position);
    obj.mesh.scale.setScalar(0.55 * scale);
    obj.life = 0;
    obj.maxLife = 0.06;
    obj.vel.set(0, 0, 0);
    obj.spin = 0;
    obj.grow = 3.2;
    this.items.push(obj);
  }

  impact(position, color = 0xffcf8a, count = 1) {
    for (let i = 0; i < count; i++) {
      const obj = this.acquire(this.flashMaterial(color), 'spark');
      obj.mesh.position.copy(position);
      obj.mesh.scale.setScalar(0.22);
      obj.life = 0;
      obj.maxLife = 0.22 + Math.random() * 0.1;
      obj.vel.set((Math.random() - 0.5) * 2.4, Math.random() * 2.2, (Math.random() - 0.5) * 2.4);
      obj.grow = -0.4;
      this.items.push(obj);
    }
    const smoke = this.acquire(this.flashMaterial(0x8a8f96), 'smoke');
    smoke.mesh.position.copy(position);
    smoke.mesh.scale.setScalar(0.25);
    smoke.life = 0;
    smoke.maxLife = 0.55;
    smoke.vel.set(0, 0.6, 0);
    smoke.grow = 1.6;
    this.items.push(smoke);
  }

  blood(position) {
    for (let i = 0; i < 3; i++) {
      const obj = this.acquire(this.flashMaterial(0xa8202a), 'blood');
      obj.mesh.position.copy(position);
      obj.mesh.scale.setScalar(0.2);
      obj.life = 0;
      obj.maxLife = 0.3;
      obj.vel.set((Math.random() - 0.5) * 1.6, Math.random() * 1.4, (Math.random() - 0.5) * 1.6);
      obj.grow = 0.4;
      this.items.push(obj);
    }
  }

  tracer(from, to, color = 0xffe1a8) {
    const geo = new THREE.BufferGeometry().setFromPoints([from.clone(), to.clone()]);
    const mat = new THREE.LineBasicMaterial({
      color: new THREE.Color(color),
      transparent: true,
      opacity: 0.85,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const line = new THREE.Line(geo, mat);
    line.frustumCulled = false;
    this.scene.add(line);
    this.tracers.push({ line, life: 0, maxLife: 0.07 });
  }

  explosion(position) {
    const light = new THREE.PointLight(0xffa04a, 60, 30, 2);
    light.position.copy(position).setY(position.y + 1.5);
    this.scene.add(light);
    this.lights.push({ light, life: 0, maxLife: 0.5, base: 60 });
    for (let i = 0; i < 10; i++) {
      const obj = this.acquire(this.flashMaterial(i % 2 ? 0xffb45c : 0x6a6258), 'smoke');
      obj.mesh.position.copy(position);
      obj.mesh.position.x += (Math.random() - 0.5) * 2;
      obj.mesh.position.z += (Math.random() - 0.5) * 2;
      obj.mesh.position.y += Math.random() * 2;
      obj.mesh.scale.setScalar(1.4);
      obj.life = 0;
      obj.maxLife = 0.9 + Math.random() * 0.6;
      obj.vel.set((Math.random() - 0.5) * 3, 1.6 + Math.random() * 2, (Math.random() - 0.5) * 3);
      obj.grow = 2.4;
      this.items.push(obj);
    }
  }

  update(dt) {
    for (let i = this.items.length - 1; i >= 0; i--) {
      const it = this.items[i];
      it.life += dt;
      const t = it.life / it.maxLife;
      if (t >= 1) {
        it.active = false;
        it.mesh.visible = false;
        this.items.splice(i, 1);
        continue;
      }
      it.mesh.position.addScaledVector(it.vel, dt);
      it.vel.y -= it.kind === 'spark' || it.kind === 'blood' ? 4.5 * dt : 0;
      it.vel.multiplyScalar(1 - Math.min(1, dt * 1.6));
      const scale = it.mesh.scale.x + it.grow * dt;
      it.mesh.scale.setScalar(Math.max(0.01, scale));
      it.mesh.material.opacity = 1 - t;
    }

    for (let i = this.tracers.length - 1; i >= 0; i--) {
      const tr = this.tracers[i];
      tr.life += dt;
      const t = tr.life / tr.maxLife;
      if (t >= 1) {
        this.scene.remove(tr.line);
        tr.line.geometry.dispose();
        tr.line.material.dispose();
        this.tracers.splice(i, 1);
        continue;
      }
      tr.line.material.opacity = 0.85 * (1 - t);
    }

    for (let i = this.lights.length - 1; i >= 0; i--) {
      const l = this.lights[i];
      l.life += dt;
      const t = l.life / l.maxLife;
      if (t >= 1) {
        this.scene.remove(l.light);
        l.light.dispose();
        this.lights.splice(i, 1);
        continue;
      }
      l.light.intensity = l.base * (1 - t);
    }
  }

  dispose() {
    this.pool.forEach((p) => {
      this.scene.remove(p.mesh);
      p.mesh.material.dispose();
    });
    this.tracers.forEach((t) => {
      this.scene.remove(t.line);
      t.line.geometry.dispose();
      t.line.material.dispose();
    });
    this.lights.forEach((l) => {
      this.scene.remove(l.light);
      l.light.dispose();
    });
    this.sprite.dispose();
    this.streak.dispose();
    this.pool = [];
    this.items = [];
    this.tracers = [];
    this.lights = [];
  }
}


