    fragmentShader: `
      varying vec3 vDir;
      uniform vec3 topColor;
      uniform vec3 horizonColor;
      uniform vec3 bottomColor;
      uniform vec3 sunColor;
      uniform vec3 sunDir;
      void main() {
        vec3 d = normalize(vDir);
        vec3 col = mix(horizonColor, topColor, smoothstep(0.0, 0.6, d.y));
        col = mix(bottomColor, col, smoothstep(-0.30, 0.04, d.y));
        float sd = max(dot(d, normalize(sunDir)), 0.0);
