import React, { useCallback, useEffect, useRef, useState } from 'react';
import { Skull } from 'lucide-react';
import GameCanvas from '@/components/game/GameCanvas';
import TitleScreen from '@/components/game/TitleScreen';
import HUD from '@/components/game/HUD';
import BuyMenu from '@/components/game/BuyMenu';
import Scoreboard from '@/components/game/Scoreboard';
import GameOverModal from '@/components/game/GameOverModal';
import PauseOverlay from '@/components/game/PauseOverlay';
import { SFX } from '@/game/audio';

export default function Home() {
  const [screen, setScreen] = useState('TITLE');
  const [mapId, setMapId] = useState('industrial');
  const [playing, setPlaying] = useState(false);
  const [session, setSession] = useState(0);
  const [snap, setSnap] = useState(null);
  const [locked, setLocked] = useState(false);
  const [buyOpen, setBuyOpen] = useState(false);
  const [scoreOpen, setScoreOpen] = useState(false);
  const [paused, setPaused] = useState(false);
  const [result, setResult] = useState(null);
  const [death, setDeath] = useState(null);
  const [muted, setMuted] = useState(false);

  const apiRef = useRef(null);
  const uiRef = useRef({});
  uiRef.current = { screen, buyOpen, scoreOpen, paused, result };

  const active = screen === 'PLAYING' && !buyOpen && !scoreOpen && !paused && !result;

  const deploy = useCallback(() => {
    SFX.ensure();
    SFX.click();
    setResult(null);
    setDeath(null);
    setBuyOpen(false);
    setScoreOpen(false);
    setPaused(false);
    setScreen('PLAYING');
    setPlaying(true);
    setSession((s) => s + 1);
  }, []);

  const toMenu = useCallback(() => {
    SFX.click();
    setScreen('TITLE');
    setPlaying(false);
    setResult(null);
    setDeath(null);
    setBuyOpen(false);
    setScoreOpen(false);
    setPaused(false);
    setSnap(null);
  }, []);

  const rematch = useCallback(() => {
    setResult(null);
    setDeath(null);
    setPaused(false);
    setBuyOpen(false);
    setScoreOpen(false);
    setPlaying(true);
    setSession((s) => s + 1);
  }, []);

  const toggleMute = useCallback(() => {
    setMuted((m) => {
      SFX.setMuted(!m);
      return !m;
    });
  }, []);

  const handleBuy = useCallback((id) => {
    const res = apiRef.current?.buy?.(id);
    if (res && res.ok) SFX.click();
    return res;
  }, []);

  // clear death overlay when a new round starts
  useEffect(() => {
    if (snap && snap.state === 'BUY_PHASE' && snap.playerAlive) setDeath(null);
  }, [snap]);

