    const spread = 70;
    const height = type === 'rain' ? 34 : 26;
    for (let i = 0; i < counts; i++) {
      positions[i * 3] = (Math.random() - 0.5) * spread;
      positions[i * 3 + 1] = Math.random() * height;
      positions[i * 3 + 2] = (Math.random() - 0.5) * spread;
      speeds[i] = type === 'rain' ? 34 + Math.random() * 16 : 1.4 + Math.random() * 1.6;
    }
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    const mat = new THREE.PointsMaterial({
      color: new THREE.Color(color),
      size: type === 'rain' ? 0.36 : type === 'snow' ? 0.16 : 0.09,
      transparent: true,
      opacity: type === 'rain' ? 0.45 : type === 'snow' ? 0.8 : 0.25,
      depthWrite: false,
      sizeAttenuation: true,
      blending: type === 'rain' ? THREE.AdditiveBlending : THREE.NormalBlending,
    });
    const points = new THREE.Points(geo, mat);
    points.frustumCulled = false;
    this.root.add(points);
    this.weather = { points, positions, speeds, count: counts, type, height, spread, geo };
  }

  build(mapId) {
    this.clear();
    this.mapId = mapId;
    const palette = PALETTES[mapId] || PALETTES.industrial;
    this.palette = palette;

    const sky = createSky(palette, 420);
    this.root.add(sky);

    this.scene.fog = new THREE.FogExp2(palette.fogColor, palette.fogDensity);
    this.scene.background = new THREE.Color(palette.skyHorizon);

    const hemi = new THREE.HemisphereLight(palette.hemiSky, palette.hemiGround, palette.hemiIntensity);
    hemi.name = 'env_hemi';
    this.root.add(hemi);

    const sunDir = new THREE.Vector3(...palette.sunDir).normalize();
    const sun = new THREE.DirectionalLight(palette.sun, palette.sunIntensity);
    sun.position.copy(sunDir).multiplyScalar(120);
    sun.castShadow = true;
    sun.shadow.mapSize.set(2048, 2048);
    sun.shadow.camera.near = 20;
    sun.shadow.camera.far = 320;
    sun.shadow.camera.left = -80;
    sun.shadow.camera.right = 80;
    sun.shadow.camera.top = 80;
    sun.shadow.camera.bottom = -80;
    sun.shadow.bias = -0.0006;
    sun.shadow.normalBias = 0.03;
    this.root.add(sun);
    this.root.add(sun.target);

    // Ambient fill so shadows never go pitch black
    const fill = new THREE.AmbientLight(palette.skyHorizon, 0.18);
    this.root.add(fill);

    // HDR-ish environment map built from the procedural sky
    this.buildEnvironmentMap(palette);

    let data;
    if (mapId === 'winter_village') data = this.buildWinterVillage();
    else if (mapId === 'night_docks') data = this.buildNightDocks();
    else data = this.buildIndustrial();

    this.createWeather(palette.weather, palette.weatherColor);

    this.scene.environmentIntensity = palette.envIntensity;
    this.renderer.toneMappingExposure = palette.exposure;

    return { ...data, palette };
  }

  buildEnvironmentMap(palette) {
    const pmrem = new THREE.PMREMGenerator(this.renderer);
    const envScene = new THREE.Scene();
    const sky = createSky(palette, 60);
    envScene.add(sky);

    const sunMat = new THREE.MeshBasicMaterial({ color: new THREE.Color(palette.sun) });
    const sunBall = new THREE.Mesh(new THREE.SphereGeometry(7, 16, 10), sunMat);
    sunBall.position.copy(new THREE.Vector3(...palette.sunDir).normalize().multiplyScalar(42));
    envScene.add(sunBall);

    const groundMat = new THREE.MeshBasicMaterial({ color: new THREE.Color(palette.skyBottom) });
    const bowl = new THREE.Mesh(
      new THREE.SphereGeometry(58, 24, 12, 0, Math.PI * 2, Math.PI / 2, Math.PI / 2),
      groundMat
    );
    envScene.add(bowl);

    const rt = pmrem.fromScene(envScene, 0.03, 0.1, 200);
    if (this.envTexture) this.envTexture.dispose();
    this.envTexture = rt.texture;
    this.scene.environment = rt.texture;
    pmrem.dispose();
    sky.geometry.dispose();
    sky.material.dispose();
    sunBall.geometry.dispose();
    sunMat.dispose();
    bowl.geometry.dispose();
    groundMat.dispose();
  }

  update(dt, time, cameraPos) {
    if (this.weather && cameraPos) {
      const w = this.weather;
      const pos = w.geo.attributes.position.array;
      const baseX = Math.round(cameraPos.x);
      const baseZ = Math.round(cameraPos.z);
      for (let i = 0; i < w.count; i++) {
        const iy = i * 3 + 1;
        pos[iy] -= w.speeds[i] * dt;
        if (w.type !== 'rain') {
          pos[i * 3] += Math.sin(time * 0.8 + i) * dt * 0.35;
        }
        if (pos[iy] < 0) {
          pos[iy] = w.height;
          pos[i * 3] = baseX + (Math.random() - 0.5) * w.spread;
          pos[i * 3 + 2] = baseZ + (Math.random() - 0.5) * w.spread;
        }
      }
      w.geo.attributes.position.needsUpdate = true;
    }

    for (let i = 0; i < this.animated.length; i++) {
      const a = this.animated[i];
      if (a.type === 'pulse') {
        a.mesh.material.opacity = a.base + Math.sin(time * 1.6) * 0.18;
      } else if (a.type === 'water') {
        a.mesh.material.roughness = 0.07 + Math.sin(time * 0.5) * 0.02;
      }
    }
  }

  dispose() {
    this.clear();
    if (this.envTexture) this.envTexture.dispose();
  }
}


