  buildWinterVillage() {
    const rand = rng(4242);
    const snowMat = getMaterial('snow', { rx: 34, ry: 34 });
    const ground = new THREE.Mesh(new THREE.PlaneGeometry(190, 190), snowMat);
    ground.rotation.x = -Math.PI / 2;
    ground.receiveShadow = true;
    this.root.add(ground);

    // snow drifts
    const driftMat = getMaterial('snow', { rx: 4, ry: 4, color: 0xf3f8ff });
    for (let i = 0; i < 26; i++) {
      const r = 2 + rand() * 6;
      const drift = new THREE.Mesh(new THREE.SphereGeometry(r, 12, 8, 0, Math.PI * 2, 0, Math.PI / 2), driftMat);
      drift.position.set(-52 + rand() * 104, -0.4, -52 + rand() * 104);
      drift.scale.y = 0.16;
      drift.receiveShadow = true;
      this.root.add(drift);
    }

    const chalet = (x, z, w, h, d, rotY) => {
      this.addBox(w, h, d, x, 0, z, 'wood', { rotY, color: 0x8a6238, rx: Math.max(1, Math.round(w / 4)), ry: Math.max(1, Math.round(h / 2.4)) });
      // stone base
      this.addBox(w + 0.3, 1.1, d + 0.3, x, 0, z, 'rock', { rotY, color: 0x8e9298, rx: 2, ry: 1, collide: false });
      // roof slabs
      const roofMat = getMaterial('roof', { rx: 3, ry: 2, color: 0x4a3a30 });
      const half = (w / 2 + 1) * 0.72;
      [-1, 1].forEach((side) => {
        const slab = new THREE.Mesh(new THREE.BoxGeometry(w + 1.6, 0.22, half + 0.6), roofMat);
        slab.position.set(
          x + Math.cos(rotY) * 0 + Math.sin(rotY) * side * (d / 4 + 1) * 0,
          h + 1.1,
          z
        );
        slab.position.set(x, h + 1.0, z + side * (d / 4 + 0.9));
        slab.rotation.x = side * -0.72;
        slab.rotation.y = rotY;
        slab.castShadow = true;
        this.root.add(slab);
        // snow cap on roof
        const snowCap = new THREE.Mesh(new THREE.BoxGeometry(w + 1.7, 0.18, half + 0.65), driftMat);
        snowCap.position.copy(slab.position);
        snowCap.position.y += 0.18;
        snowCap.rotation.copy(slab.rotation);
        this.root.add(snowCap);
      });
      // warm windows
      const glow = getGlowMaterial(0xffb861, 2.2);
      for (let i = 0; i < Math.max(2, Math.floor(w / 4)); i++) {
        const ox = (i / (Math.max(2, Math.floor(w / 4)) - 1 || 1) - 0.5) * (w - 3);
        const win = new THREE.Mesh(new THREE.BoxGeometry(1.1, 1.3, 0.12), glow);
        win.position.set(x + Math.cos(rotY) * ox, h * 0.55, z - Math.sin(rotY) * ox - d / 2 - 0.02);
        win.rotation.y = rotY;
        this.root.add(win);
        const light = new THREE.PointLight(0xffa955, 9, 9, 2);
        light.position.set(x + Math.cos(rotY) * ox, h * 0.55, z - Math.sin(rotY) * ox - d / 2 - 0.9);
        this.root.add(light);
      }
      // chimney
      this.addBox(0.7, 1.6, 0.7, x + w * 0.28, h + 1.3, z - d * 0.2, 'brick', { color: 0x8a5a4a, collide: false });
    };

    chalet(-30, -20, 16, 7, 13, 0);
    chalet(26, -26, 18, 8, 14, 0.12);
    chalet(-26, 26, 14, 6.5, 12, -0.1);
    chalet(24, 24, 15, 7, 12, 0.06);
    chalet(0, -38, 20, 9, 14, 0);

    // church tower with lit clock
    this.addBox(6, 22, 6, 44, 0, 6, 'brick', { color: 0x9a938a, rx: 2, ry: 6 });
    const clock = new THREE.Mesh(new THREE.CircleGeometry(1.3, 24), getGlowMaterial(0xfff0c0, 2.4));
    clock.position.set(44, 17, 3 - 0.02);
    clock.rotation.y = Math.PI;
    this.root.add(clock);
    const spire = new THREE.Mesh(new THREE.ConeGeometry(4.6, 7, 4), getMaterial('roof', { color: 0x3b3229 }));
    spire.position.set(44, 25.5, 6);
    spire.rotation.y = Math.PI / 4;
    spire.castShadow = true;
    this.root.add(spire);

    // stone walls / fences
    const wallMat = getMaterial('rock', { rx: 3, ry: 1, color: 0x9aa0a6 });
    [[-10, 12, 14, 1.1, 0.8], [10, 8, 12, 1.1, 0.8], [-2, -14, 16, 1.2, 0.9]].forEach(([x, z, len, h, d]) => {
      const wall = new THREE.Mesh(new THREE.BoxGeometry(len, h, d), wallMat);
      wall.position.set(x, h / 2, z);
      wall.castShadow = true;
      wall.receiveShadow = true;
      this.root.add(wall);
      this.colliders.push(makeBox(x, 0, z, len, h, d, 'rock'));
      const cap = new THREE.Mesh(new THREE.BoxGeometry(len, 0.14, d + 0.1), getMaterial('snow', { color: 0xf0f6ff, rx: 3, ry: 1 }));
      cap.position.set(x, h + 0.06, z);
      this.root.add(cap);
    });

    // trees
    for (let i = 0; i < 30; i++) {
      const x = -58 + rand() * 116;
      const z = -58 + rand() * 116;
      if (Math.abs(x) < 16 && Math.abs(z) < 16) continue;
      this.addTree(x, z, 0.8 + rand() * 0.55, true);
    }

    // village well
    const wellMat = getMaterial('rock', { color: 0x8b8f94, rx: 2, ry: 1 });
    this.addCylinder(1.5, 1.6, 1.0, 0, 0, 0, wellMat, { collide: true, radius: 1.6 });
    const wellRoof = new THREE.Mesh(new THREE.ConeGeometry(2.2, 1.4, 8), getMaterial('wood', { color: 0x5a3f2c }));
    wellRoof.position.set(0, 3.2, 0);
    this.root.add(wellRoof);
    [-0.9, 0.9].forEach((ox) => {
      this.addBox(0.16, 2.4, 0.16, ox, 1, 0, 'wood', { color: 0x3f2c1f, collide: false });
    });

    // barrels, crates, haystacks
    for (let i = 0; i < 12; i++) {
      if (rand() > 0.5) this.addCrate(-40 + rand() * 80, -40 + rand() * 80, 0, 0.9 + rand() * 0.3, rand() * 3);
      else this.addBarrel(-40 + rand() * 80, -40 + rand() * 80, 0, 0x6b4a2a);
    }
    const hayMat = getMaterial('wood', { color: 0xc9a45c, rx: 2, ry: 2 });
    for (let i = 0; i < 6; i++) {
      this.addCylinder(1.1, 1.1, 1.4, -46 + rand() * 92, 0, -46 + rand() * 92, hayMat, { collide: true, radius: 1.1 });
    }

    // lanterns along the main lane
    for (let i = -2; i <= 2; i++) {
      const pole = getMaterial('metal', { color: 0x2f3237 });
      this.addCylinder(0.07, 0.09, 3.4, i * 11, 0, 10, pole, { collide: true, radius: 0.1 });
      const lantern = new THREE.Mesh(new THREE.BoxGeometry(0.36, 0.5, 0.36), getGlowMaterial(0xffbb63, 3));
      lantern.position.set(i * 11, 3.5, 10);
      this.root.add(lantern);
      const light = new THREE.PointLight(0xffb060, 16, 14, 2);
      light.position.set(i * 11, 3.4, 10);
      this.root.add(light);
    }

    // perimeter rock cliffs
    const cliffMat = getMaterial('rock', { rx: 8, ry: 2, color: 0x6f757c });
    for (let i = 0; i < 34; i++) {
      const angle = (i / 34) * Math.PI * 2;
      const r = 66 + rand() * 6;
      const x = Math.cos(angle) * r;
      const z = Math.sin(angle) * r;
