      rock.position.set(x, h / 2, z);
      rock.rotation.y = rand() * 6;
      rock.castShadow = true;
      rock.receiveShadow = true;
      this.root.add(rock);
      this.colliders.push(makeBox(x, 0, z, 9, h, 9, 'rock'));
    }

    for (let i = 0; i < 10; i++) this.addPuddle(-40 + rand() * 80, -40 + rand() * 80, 1 + rand() * 2, 0.35);

    const siteA = { id: 'A', x: -22, z: -6, radius: 4.4 };
    const siteB = { id: 'B', x: 28, z: 30, radius: 4.4 };
    this.addSiteMarker(siteA);
