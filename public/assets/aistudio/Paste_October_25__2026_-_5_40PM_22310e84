import * as THREE from 'three';
import { WEAPONS, createSoldier } from './weapons';
import { hasLineOfSight, rayWorld, raySphere, resolveCollisions } from './physics';
import { SFX } from './audio';

export const BUY_PHASE_TIME = 20;
export const ROUND_TIME = 115;
export const ROUND_END_TIME = 5;
export const MAX_ROUNDS = 13;
export const ARMOR_PRICE = 650;
export const HELMET_PRICE = 1000;

const ALLY_NAMES = ['HAVOC', 'RAVEN', 'SABLE', 'KESTREL', 'NOMAD'];
const ENEMY_NAMES = ['VEIL', 'KRAIT', 'ONYX', 'TALON', 'DRAKE'];

const BOT_LOADOUTS = [
  { id: 'm4a1', cost: 3100 },
  { id: 'mp5', cost: 1500 },
  { id: 'awp', cost: 4750 },
  { id: 'shotgun', cost: 1800 },
  { id: 'p250', cost: 300 },
];

function makeCombatant(data) {
  return {
    alive: true,
    hp: 100,
    maxHp: 100,
    armor: 0,
    hasHelmet: false,
    cash: 800,
    weaponId: 'p250',
    mag: 13,
    reserve: 52,
    kills: 0,
    deaths: 0,
    damageDealt: 0,
    pos: new THREE.Vector3(),
    yaw: 0,
    vel: new THREE.Vector3(),
    isPlayer: false,
    ...data,
  };
}

export class Match {
  constructor(scene, world, effects, callbacks = {}) {
    this.scene = scene;
    this.world = world;
    this.effects = effects;
    this.callbacks = callbacks;
    this.colliders = [];
    this.combatants = [];
    this.killfeed = [];
    this.state = 'BUY_PHASE';
    this.roundTimer = BUY_PHASE_TIME;
    this.roundNumber = 1;
    this.scoreVanguard = 0;
    this.scoreSyndicate = 0;
    this.mapData = null;
    this.player = null;
    this.lastRoundResult = null;
    this.killCounter = 0;
    this.startTime = 0;
  }

  start(mapId, mapData) {
    this.disposeBots();
    this.mapData = mapData;
    this.colliders = mapData.colliders;
    this.combatants = [];
    this.killfeed = [];
    this.roundNumber = 1;
    this.scoreVanguard = 0;
    this.scoreSyndicate = 0;
    this.lastRoundResult = null;

    const player = makeCombatant({
      id: 'player',
      name: 'OPERATOR',
      team: 'VANGUARD',
      isPlayer: true,
      cash: 800,
      weaponId: 'p250',
      mag: WEAPONS.p250.magSize,
      reserve: WEAPONS.p250.reserveAmmo,
      pos: mapData.allySpawns[2].clone(),
    });
    this.combatants.push(player);
    this.player = player;

    for (let i = 0; i < 4; i++) {
      this.combatants.push(
        makeCombatant({
          id: `ally_${i}`,
          name: ALLY_NAMES[i],
          team: 'VANGUARD',
          weaponId: 'm4a1',
          mag: WEAPONS.m4a1.magSize,
          reserve: WEAPONS.m4a1.reserveAmmo,
          mesh: this.createBotMesh('VANGUARD', i),
          pos: mapData.allySpawns[i].clone(),
        })
      );
    }
    for (let i = 0; i < 5; i++) {
      this.combatants.push(
        makeCombatant({
          id: `enemy_${i}`,
          name: ENEMY_NAMES[i],
          team: 'SYNDICATE',
          weaponId: i === 0 ? 'awp' : 'm4a1',
          mag: i === 0 ? WEAPONS.awp.magSize : WEAPONS.m4a1.magSize,
          reserve: i === 0 ? WEAPONS.awp.reserveAmmo : WEAPONS.m4a1.reserveAmmo,
          mesh: this.createBotMesh('SYNDICATE', i),
          pos: mapData.enemySpawns[i].clone(),
        })
      );
    }

    this.beginRound(true);
  }

  createBotMesh(team, variant) {
    const mesh = createSoldier(team, variant);
    mesh.visible = false;
    this.scene.add(mesh);
    return mesh;
  }

  disposeBots() {
    this.combatants.forEach((c) => {
      if (c.mesh) {
        this.scene.remove(c.mesh);
        c.mesh.traverse((n) => {
          if (n.geometry) n.geometry.dispose();
          if (n.material) {
            const mats = Array.isArray(n.material) ? n.material : [n.material];
            mats.forEach((m) => m.dispose && m.dispose());
          }
        });
      }
    });
  }

  setState(state) {
    this.state = state;
    if (this.callbacks.onStateChange) this.callbacks.onStateChange(state);
  }

