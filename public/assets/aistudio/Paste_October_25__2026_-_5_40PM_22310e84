  resolveShot(origin, dir, weapon, shooter, isPlayer) {
    const maxRange = weapon.rangeMeters * 1.35;
    const worldHit = rayWorld(origin, dir, maxRange, this.colliders);
    let limit = worldHit.box ? worldHit.t : maxRange;
    let result = {
      hit: false,
      headshot: false,
      point: new THREE.Vector3().copy(origin).addScaledVector(dir, limit),
      target: null,
      damaged: 0,
      killed: false,
    };

    let bestT = limit;
    let bestTarget = null;
    let headshot = false;

    for (let i = 0; i < this.combatants.length; i++) {
      const c = this.combatants[i];
      if (!c.alive || c.team === shooter.team) continue;
      const headT = raySphere(origin.x, origin.y, origin.z, dir.x, dir.y, dir.z, c.pos.x, c.pos.y + 1.72, c.pos.z, 0.22);
      const bodyT = raySphere(origin.x, origin.y, origin.z, dir.x, dir.y, dir.z, c.pos.x, c.pos.y + 1.15, c.pos.z, 0.42);
      if (headT > 0 && headT < bestT) {
        bestT = headT;
        bestTarget = c;
        headshot = true;
      }
      if (bodyT > 0 && bodyT < bestT) {
        bestT = bodyT;
        bestTarget = c;
        headshot = false;
      }
    }

    if (!bestTarget) {
      return result;
    }

    const point = new THREE.Vector3().copy(origin).addScaledVector(dir, bestT);
    const falloff = bestT <= weapon.rangeMeters ? 1 : Math.max(0.55, 1 - (bestT - weapon.rangeMeters) / weapon.rangeMeters);
    const baseDamage = weapon.damage * falloff * (headshot ? weapon.headshotMultiplier : 1);
    const damage = Math.round(baseDamage * (this.state === 'LIVE_COMBAT' ? 1 : 0.0));

    result.hit = true;
    result.headshot = headshot;
    result.point = point;
    result.target = bestTarget;

    if (damage > 0) {
      const killed = this.applyDamage(bestTarget, damage, shooter, headshot, weapon);
      result.damaged = damage;
      result.killed = killed;
    }

    if (isPlayer) {
      this.effects.blood(point);
      SFX.hit(headshot);
      if (this.callbacks.onHitmarker) this.callbacks.onHitmarker(headshot);
    }

    return result;
  }

  applyDamage(target, amount, attacker, headshot, weapon) {
    if (!target.alive) return false;
    let dmg = amount;
    if (target.armor > 0) {
      const absorbed = headshot && target.hasHelmet ? dmg * 0.3 : dmg * 0.5;
      target.armor = Math.max(0, target.armor - absorbed * 0.8);
      dmg -= absorbed;
    }
    target.hp -= dmg;
    attacker.damageDealt += dmg;

    if (target.isPlayer && this.callbacks.onPlayerDamage) {
      this.callbacks.onPlayerDamage(dmg, attacker.pos.clone(), headshot);
      SFX.hurt();
    }

    if (target.hp <= 0) {
      this.kill(target, attacker, weapon, headshot);
      return true;
    }
    return false;
  }

  kill(victim, killer, weapon, headshot) {
