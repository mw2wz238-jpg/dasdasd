function noiseT(x, y, period, seed) {
  const xi = Math.floor(x), yi = Math.floor(y);
  const xf = x - xi, yf = y - yi;
  const u = xf * xf * (3 - 2 * xf);
  const v = yf * yf * (3 - 2 * yf);
  const p = Math.max(1, Math.round(period));
  const w = (a, b) => hash(((a % p) + p) % p, ((b % p) + p) % p, seed);
  const a00 = w(xi, yi), a10 = w(xi + 1, yi), a01 = w(xi, yi + 1), a11 = w(xi + 1, yi + 1);
  const top = a00 * (1 - u) + a10 * u;
  const bot = a01 * (1 - u) + a11 * u;
  return top * (1 - v) + bot * v;
}
function fbmT(u, v, baseFreq, octaves, seed) {
  let sum = 0, amp = 0.5, freq = baseFreq, norm = 0;
